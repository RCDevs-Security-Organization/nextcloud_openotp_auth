{
	"name": "openotp_auth",
	"version": "1.34.0",
	"description": "WebAuthn second factor provider for Nextcloud",
	"private": true,
	"dependencies": {
		"@nextcloud/auth": "^2.4.0",
		"@nextcloud/axios": "^2.5.1",
		"@nextcloud/dialogs": "^7.4.1",
		"@nextcloud/initial-state": "^3.0.0",
		"@nextcloud/logger": "^3.0.2",
		"@nextcloud/moment": "^1.3.2",
		"@nextcloud/password-confirmation": "^6.1.0",
		"@nextcloud/router": "^3.1.0",
		"@nextcloud/vue": "^9.9.0",
		"buffer": "^6.0.3",
		"linkifyjs": "^4.2.0",
		"node-stdlib-browser": "^1.3.1",
		"process": "^0.11.10",
		"vue": "^3.5.18",
		"vue-material-design-icons": "^5.3.1",
		"vuex": "^4.1.0"
	},
	"scripts": {
		"dev": "NODE_ENV=development webpack --progress",
		"watch": "NODE_ENV=development webpack --progress --watch",
		"build": "NODE_ENV=production webpack --progress",
		"lint": "eslint --ext .js,.vue src",
		"lint:fix": "eslint --ext .js,.vue src --fix",
		"test:unit": "mochapack --mode development --webpack-config webpack.test.config.js --require src/tests/unit/setup.js src/tests/unit/**/*.spec.js",
		"test:unit:watch": "mochapack --mode development -w --webpack-config webpack.test.config.js --require src/tests/unit/setup.js src/tests/unit/**/*.spec.js",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"browserslist": [
		"last 2 versions",
		"not dead",
		"not ie <= 11"
	],
	"engines": {
		"node": "^20.0.0",
		"npm": "^10.0.0"
	},
	"jshintConfig": {
		"esversion": 6
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nextcloud/openotp_auth.git"
	},
	"author": "Christoph Wurst",
	"license": "AGPL-3.0",
	"bugs": {
		"url": "https://github.com/nextcloud/openotp_auth/issues"
	},
	"homepage": "https://github.com/nextcloud/openotp_auth#readme",
	"devDependencies": {
		"@babel/core": "^7.26.10",
		"@babel/plugin-syntax-dynamic-import": "^7.8.3",
		"@babel/preset-env": "^7.26.9",
		"@nextcloud/babel-config": "^1.2.0",
		"@nextcloud/webpack-vue-config": "^7.0.4",
		"@vue/compiler-sfc": "^3.5.18",
		"babel-loader": "^10.0.0",
		"css-loader": "^7.1.2",
		"node-polyfill-webpack-plugin": "4.0.0",
		"sass": "^1.86.1",
		"sass-loader": "^17.0.0",
		"style-loader": "^4.0.0",
		"vue-loader": "^17.4.2",
		"webpack": "^5.98.0",
		"webpack-cli": "^6.0.1"
	}
}
